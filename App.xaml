<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CodeScanner.Converters"
             x:Class="CodeScanner.App">
    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Color Palette - Professional Dark Theme -->
            <Color x:Key="PrimaryColor">#6366F1</Color>
            <Color x:Key="PrimaryColorLight">#EEF2FF</Color>
            <Color x:Key="PrimaryColorDark">#4F46E5</Color>
            
            <Color x:Key="AccentColor">#10B981</Color>
            <Color x:Key="AccentColorLight">#D1FAE5</Color>
            
            <Color x:Key="SuccessColor">#22C55E</Color>
            <Color x:Key="SuccessColorLight">#DCFCE7</Color>
            
            <Color x:Key="WarningColor">#F59E0B</Color>
            <Color x:Key="WarningColorLight">#FEF3C7</Color>
            
            <Color x:Key="DangerColor">#EF4444</Color>
            <Color x:Key="DangerColorLight">#FEE2E2</Color>
            
            <Color x:Key="InfoColor">#3B82F6</Color>
            <Color x:Key="InfoColorLight">#DBEAFE</Color>
            
            <!-- Background Colors -->
            <Color x:Key="PageBackground">#F8FAFC</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="SurfaceColor">#F1F5F9</Color>
            
            <!-- Text Colors -->
            <Color x:Key="TextPrimary">#1E293B</Color>
            <Color x:Key="TextSecondary">#64748B</Color>
            <Color x:Key="TextTertiary">#94A3B8</Color>
            <Color x:Key="TextOnPrimary">#FFFFFF</Color>
            
            <!-- Border Colors -->
            <Color x:Key="BorderColor">#E2E8F0</Color>
            <Color x:Key="BorderColorLight">#F1F5F9</Color>
            
            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringTruncateConverter x:Key="StringTruncateConverter"/>
            <converters:FormatBadgeColorConverter x:Key="FormatBadgeColorConverter"/>
            <converters:TorchBackgroundConverter x:Key="TorchBackgroundConverter"/>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            
            <!-- Typography Styles -->
            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontFamily" Value="OpenSansSemibold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            </Style>
            
            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
            </Style>
            
            <Style x:Key="SectionHeaderLabel" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="OpenSansSemibold"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="CharacterSpacing" Value="0.5"/>
            </Style>
            
            <Style x:Key="BodyLabel" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            </Style>
            
            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
            </Style>
            
            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#20000000" 
                                Offset="0,2" 
                                Radius="8" 
                                Opacity="0.1"/>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Button Styles -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}"/>
                <Setter Property="FontFamily" Value="OpenSansSemibold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="24,16"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="OpenSansSemibold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="20,14"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            
            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
            
            <Style x:Key="SmallTextButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="4,2"/>
            </Style>
            
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            
            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HeightRequest" Value="32"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
