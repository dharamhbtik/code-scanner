<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CodeScanner.ViewModels"
             x:Class="CodeScanner.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Code Scanner"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        
        <!-- Header -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0"
                Padding="24,48,24,24">
            <VerticalStackLayout Spacing="4">
                <Label Text="Code Scanner"
                       Style="{StaticResource TitleLabel}"
                       FontSize="28"/>
                <Label Text="Professional barcode scanning"
                       Style="{StaticResource SubtitleLabel}"/>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8" Padding="16">
                            <Label Text="{Binding EnabledFormatCount}"
                                   FontSize="32"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="Enabled Formats"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8" Padding="16">
                            <Label Text="{Binding ScanCount}"
                                   FontSize="32"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource AccentColor}"/>
                            <Label Text="Total Scans"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Last Scan Card -->
                <Border Style="{StaticResource CardStyle}" 
                        IsVisible="{Binding HasRecentScan}">
                    <Grid RowDefinitions="Auto,Auto,Auto" Padding="16" RowSpacing="8">
                        <Label Grid.Row="0" 
                               Text="Last Scan"
                               Style="{StaticResource SectionHeaderLabel}"/>
                        <Border Grid.Row="1" 
                                BackgroundColor="{StaticResource SurfaceColor}"
                                StrokeThickness="0"
                                Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding LastScanValue}"
                                   FontFamily="monospace"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="TailTruncation"/>
                        </Border>
                        <HorizontalStackLayout Grid.Row="2" Spacing="8">
                            <Border BackgroundColor="{StaticResource PrimaryColorLight}"
                                    StrokeThickness="0"
                                    Padding="8,4"
                                    StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding LastScanFormat}"
                                       FontSize="12"
                                       TextColor="{StaticResource PrimaryColor}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Quick Actions -->
                <Label Text="Quick Actions" 
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,8,0,0"/>
                
                <!-- Format Selection Card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16">
                        <Border Grid.Column="0" 
                                WidthRequest="48" 
                                HeightRequest="48"
                                BackgroundColor="{StaticResource PrimaryColorLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="⚙"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" 
                                             VerticalOptions="Center" 
                                             Spacing="2"
                                             Margin="16,0">
                            <Label Text="Barcode Formats"
                                   Style="{StaticResource BodyLabel}"
                                   FontFamily="OpenSansSemibold"/>
                            <Label Text="Configure which formats to scan"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" 
                               Text="›"
                               FontSize="24"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFormatSelectionCommand}"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- History Card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16">
                        <Border Grid.Column="0" 
                                WidthRequest="48" 
                                HeightRequest="48"
                                BackgroundColor="{StaticResource AccentColorLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="📋"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" 
                                             VerticalOptions="Center" 
                                             Spacing="2"
                                             Margin="16,0">
                            <Label Text="Scan History"
                                   Style="{StaticResource BodyLabel}"
                                   FontFamily="OpenSansSemibold"/>
                            <Label Text="{Binding ScanCount, StringFormat='{0} scans saved'}"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" 
                               Text="›"
                               FontSize="24"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Scan Button -->
        <Border Grid.Row="2" 
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0"
                Padding="24,16,24,32">
            <Button Text="Start Scanning"
                    Command="{Binding StartScanCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="56"
                    CornerRadius="16"/>
        </Border>

    </Grid>
</ContentPage>
